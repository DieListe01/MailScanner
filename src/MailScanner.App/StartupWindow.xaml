<Window x:Class="MailScanner.App.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MailScanner wird gestartet"
        Width="470"
        Height="270"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Background="#0E1626"
             BorderBrush="#334155"
             BorderThickness="1"
             CornerRadius="22"
             Padding="0"
             Effect="{StaticResource WindowShadow}">
        <Grid>
            <Border Background="#111827"
                    CornerRadius="22"
                    Margin="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            CornerRadius="21,0,0,21">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#38BDF8" Offset="0"/>
                                <GradientStop Color="#0EA5E9" Offset="0.55"/>
                                <GradientStop Color="#0369A1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Grid.Column="1" Margin="22,20,22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="13"
                                    Background="#122235"
                                    BorderBrush="#38BDF8"
                                    BorderThickness="1">
                                <Viewbox Margin="10">
                                    <Grid Width="24" Height="24">
                                        <Path Data="M3,5 L12,11 L21,5 M4,6 L4,18 L20,18 L20,6"
                                              Stroke="#D8E6FF"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,1,0,0">
                                <TextBlock Text="MAILSCANNER"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#8FB8FF"/>
                                <TextBlock Text="Startet"
                                           Margin="0,4,0,0"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="#0F1725"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,4"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding VersionLabel}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#D7E5FF"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="0,18,0,0"
                                   Text="Einstellungen, Datenbank und Arbeitsbereiche werden vorbereitet."
                                   FontSize="12"
                                   Foreground="#B6C3D8"
                                   TextWrapping="Wrap"/>

                        <Border Grid.Row="2"
                                Margin="0,16,0,0"
                                Background="#101824"
                                BorderBrush="#273548"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Initialisierung"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#DDE8F9"/>
                                    <TextBlock Text="Theme, Einstellungen und lokale Datenquellen werden geladen."
                                               Margin="0,5,0,0"
                                               FontSize="10.5"
                                               Foreground="#8FA4C2"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#10231B"
                                        BorderBrush="#2D6E55"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="8,3"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="STARTUP"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#8BE0B7"/>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="4">
                            <ProgressBar IsIndeterminate="True"
                                         Height="8"
                                         Margin="0,0,0,10"
                                         Background="#0A101A"
                                         Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Bitte einen Moment warten..."
                                       FontSize="11"
                                       Foreground="#90A0B9"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
