<Window x:Class="MailScanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MailScanner"
        Width="1480"
        Height="940"
        MinWidth="1260"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Margin="12"
            Background="{StaticResource ChromeBrush}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="18"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0">
                <Grid MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource HeaderIconTile}">
                            <Grid Margin="5">
                                <Path Data="M 2 4 L 12 4 L 12 11 L 2 11 Z M 2 4 L 7 8 L 12 4"
                                      Stroke="#C5D8FF"
                                      StrokeThickness="1.25"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Fill"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="MailScanner" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Margin="14,0,14,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5"
                               Text="{Binding BusyMessage}"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Grid.Column="2"
                            Margin="0,0,8,0"
                            Style="{StaticResource TitlePill}"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="{Binding CurrentVersionSummary}" FontSize="10.5" FontWeight="SemiBold" Foreground="#D9E6FF"/>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowControlButton}" Click="OnMinimizeWindowClicked" Content="-"/>
                        <Button Style="{StaticResource WindowControlButton}" Click="OnToggleMaximizeWindowClicked" Content="[]"/>
                        <Button Style="{StaticResource WindowControlButton}" Click="OnCloseWindowClicked" Content="X"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="186"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,18">
                    <Grid Margin="10,12,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="#171C25" BorderBrush="#2D3544" BorderThickness="1" CornerRadius="12" Padding="10,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" Background="#18355B" BorderBrush="#5E8EFA" BorderThickness="1" CornerRadius="9" VerticalAlignment="Top">
                                    <Viewbox Margin="7">
                                        <Grid Width="16" Height="16">
                                            <Path Data="M3,4 L8,8 L13,4 M3,4 L3,12 L13,12 L13,4"
                                                  Stroke="#D8E6FF"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="MailScanner" Margin="0,3,0,0" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Scanner und Treffer kompakt an einem Ort." Margin="0,4,0,0" FontSize="9.6" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                            <TextBlock Text="BEREICHE" Margin="2,0,0,8" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <Button x:Name="DashboardButton" Style="{StaticResource NavigationButton}" Click="OnDashboardNavClicked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconTile}">
                                        <Viewbox Margin="5">
                                            <Grid Width="12" Height="12">
                                                <Rectangle Width="10" Height="10" Stroke="#C6CEDC" StrokeThickness="1.2" RadiusX="1" RadiusY="1"/>
                                                <Path Data="M 0 4 L 10 4 M 5 0 L 5 10" Stroke="#C6CEDC" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="ResultsButton" Style="{StaticResource NavigationButton}" Click="OnResultsNavClicked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconTile}">
                                        <Viewbox Margin="5">
                                            <Grid Width="12" Height="12">
                                                <Rectangle Width="9" Height="9" Stroke="#C6CEDC" StrokeThickness="1.4" RadiusX="1" RadiusY="1"/>
                                                <Path Data="M 1 4.5 L 11 4.5 M 4.5 1 L 4.5 11" Stroke="#C6CEDC" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Treffer" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="AccountButton" Style="{StaticResource NavigationButton}" Click="OnAccountSettingsClicked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconTile}">
                                        <Viewbox Margin="5">
                                            <Grid Width="12" Height="12">
                                                <Ellipse Width="4.8" Height="4.8" Stroke="#C6CEDC" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                                <Path Data="M 1.5 11 C 2.4 8.4 9.6 8.4 10.5 11" Stroke="#C6CEDC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Konten" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="ConnectionsButton" Style="{StaticResource NavigationButton}" Click="OnTestConnectionsClicked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconTile}">
                                        <Viewbox Margin="5">
                                            <Grid Width="12" Height="12">
                                                <Ellipse Width="2.8" Height="2.8" Fill="#C6CEDC" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <Ellipse Width="2.8" Height="2.8" Fill="#C6CEDC" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                                <Ellipse Width="2.8" Height="2.8" Fill="#C6CEDC" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                <Path Data="M 3 6 L 8.5 2.6 M 3 6 L 8.5 9.4" Stroke="#C6CEDC" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Verbindungen" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="UpdateButton" Style="{StaticResource NavigationButton}" Click="OnUpdateClicked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconTile}">
                                        <Viewbox Margin="5">
                                            <Grid Width="12" Height="12">
                                                <Path Data="M 6 1 L 6 7.5 M 3.5 5 L 6 7.5 L 8.5 5 M 2 10.5 L 10 10.5" Stroke="#C6CEDC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Update" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Button>

                            <Button x:Name="DebugButton" Style="{StaticResource NavigationButton}" Click="OnOpenDebugClicked">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconTile}">
                                        <Viewbox Margin="5">
                                            <Grid Width="12" Height="12">
                                                <Path Data="M 0 1 L 4 4 L 0 7" Stroke="#C6CEDC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <Rectangle Width="5" Height="1.4" Fill="#C6CEDC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Debug" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <TextBlock Text="AKTION" Margin="2,10,0,8" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Visibility="{Binding BusyVisibility}"/>
                            <Button x:Name="StopButton" Style="{StaticResource NavigationButton}" Click="OnStopClicked" Visibility="{Binding BusyVisibility}" Margin="0,0,0,0">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" Background="#5B2A31" BorderBrush="#8C4E58" BorderThickness="1" CornerRadius="6">
                                        <Viewbox Margin="6">
                                            <Rectangle Width="8" Height="8" Fill="#FFD9DE" RadiusX="1" RadiusY="1"/>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Stoppen" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <Border Style="{StaticResource SurfaceCard}" Background="#1A2029" Padding="9">
                                <StackPanel>
                                    <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding AccountCountSummary}" Margin="0,5,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding LatestVersionSummary}" Margin="0,3,0,0" FontSize="9.8" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="16">
                    <Grid x:Name="ScannerWorkspace" Visibility="{Binding ScannerPageVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="290"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="SCANNER WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#9DB6E6"/>
                                    <TextBlock Text="MailScanner" Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Dokumentkandidaten aus E-Mails finden, priorisieren und lokal verwalten." Margin="0,3,0,0" FontSize="10.5" Foreground="#C7D0DD" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StatusMessage}" Margin="0,6,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>

                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Style="{StaticResource ChipBorder}" Background="#0F1725" BorderBrush="#334155">
                                            <TextBlock Text="{Binding AccountCountSummary}" FontSize="11" Foreground="#D9E6FF"/>
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}" Background="#0F1725" BorderBrush="#334155">
                                            <TextBlock Text="{Binding LookbackScopeSummary}" FontSize="11" Foreground="#D9E6FF"/>
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}" Background="#0F1725" BorderBrush="#334155">
                                            <TextBlock Text="{Binding ExcludedFoldersSummary}" FontSize="11" Foreground="#D9E6FF"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <Border Background="#0F1725" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="12" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Release-Status" FontSize="11" FontWeight="SemiBold" Foreground="#B8CCF3"/>
                                            <TextBlock Text="{Binding LatestVersionSummary}" Margin="0,5,0,0" FontSize="12" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding UpdateStatusSummary}" Margin="0,5,0,0" FontSize="10.2" Foreground="#D3DEEF" TextWrapping="Wrap"/>
                                            <Button Content="Update holen" Style="{StaticResource ToolPrimaryButton}" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnQuickUpdateDownloadClicked" IsEnabled="{Binding CanInstallUpdate}"/>
                                            <StackPanel Margin="0,10,0,0" Visibility="{Binding UpdateDownloadProgressVisibility}">
                                                <ProgressBar Margin="0,8,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding UpdateDownloadProgressValue}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="108"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0F1725" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="Verbindungstest" FontSize="11" FontWeight="SemiBold" Foreground="#B8CCF3"/>
                                                <TextBlock Text="{Binding LastConnectionTestSummary}" Margin="0,6,0,0" FontSize="10.2" Foreground="#D3DEEF" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="ScanStartButton" Grid.Column="1" Content="Scan starten" Style="{StaticResource ToolPrimaryButton}" Height="40" VerticalAlignment="Stretch" Click="OnRefreshClicked"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource DashboardStatButton}" Padding="0" Click="OnDashboardAccountsClicked" ToolTip="Oeffnet die Kontenverwaltung mit allen konfigurierten Postfaechern.">
                                <Border Style="{StaticResource RaisedCard}" BorderBrush="#3E5E99" Padding="10,9">
                                    <StackPanel>
                                    <TextBlock Text="Konten" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding AccountCountSummary}" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ScannedMailCountSummary}" Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="Aktion: Konten verwalten" Margin="0,8,0,0" FontSize="10" Foreground="#8FB8FF"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource DashboardStatButton}" Padding="0" Click="OnDashboardMissingClicked" ToolTip="Zeigt Treffer, bei denen die Datei lokal noch fehlt und erst heruntergeladen werden muss.">
                                <Border Style="{StaticResource RaisedCard}" BorderBrush="#734349" Padding="10,9">
                                    <StackPanel>
                                    <TextBlock Text="Datei fehlt" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DashboardMissingCountLabel}" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}"/>
                                    <TextBlock Text="Lokale Datei fehlt" Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="Aktion: nur fehlende anzeigen" Margin="0,8,0,0" FontSize="10" Foreground="#FCA5A5"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Grid.Column="4" Style="{StaticResource DashboardStatButton}" Padding="0" Click="OnDashboardDocumentsClicked" ToolTip="Zeigt alle erkannten Dokument-Treffer aus dem aktuellen Suchbereich.">
                                <Border Style="{StaticResource RaisedCard}" BorderBrush="#6B5933" Padding="10,9">
                                    <StackPanel>
                                    <TextBlock Text="Dokumente" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DashboardDocumentCountLabel}" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"/>
                                    <TextBlock Text="PDF / DOC Treffer" Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="Aktion: alle Dokumente anzeigen" Margin="0,8,0,0" FontSize="10" Foreground="#FACC15"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Grid.Column="6" Style="{StaticResource DashboardStatButton}" Padding="0" Click="OnDashboardInvoicesClicked" ToolTip="Springt direkt zu den gefilterten Rechnungs-Treffern.">
                                <Border Style="{StaticResource RaisedCard}" BorderBrush="#734349" Padding="10,9">
                                    <StackPanel>
                                    <TextBlock Text="Rechnungen" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DashboardInvoiceCountLabel}" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}"/>
                                    <TextBlock Text="Erkannte Rechnungen" Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="Aktion: nur Rechnungen anzeigen" Margin="0,8,0,0" FontSize="10" Foreground="#FCA5A5"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Margin="0,0,0,10" Visibility="{Binding BusyVisibility}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.15*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Live-Scan" Style="{StaticResource SectionTitle}" Margin="0"/>
                                            <Border Style="{StaticResource ChipBorder}" Margin="10,0,0,0" Background="#18202B" BorderBrush="#42577D">
                                                <TextBlock Text="{Binding ScanPhaseLabel}" FontSize="10.5" Foreground="#D9E6FF"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="Stoppen" Style="{StaticResource ToolDangerButton}" Click="OnStopClicked" Width="90" HorizontalAlignment="Right" Visibility="{Binding StopScanVisibility}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="74"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Value="{Binding ScanProgressPercentage}" Maximum="100" Margin="0,4,12,0" Foreground="{Binding ScanProgressBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ScanProgressPercentage, StringFormat={}{0:F0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ScanProgressBrush}"/>
                                    </Grid>

                                    <TextBlock Text="{Binding ScanProgressSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CurrentScanTarget}" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                                    <Border Style="{StaticResource InsetCard}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding LiveScanInfo}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding AccountSettingsInfo}" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource InsetCard}">
                                    <StackPanel>
                                        <TextBlock Text="Scan-Kontext" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Scanbereich" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LookbackScopeValue}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ausgeschlossene Ordner" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ExcludedFoldersValue}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Aelteste Mail" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OldestMailValue}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource InsetCard}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#1A1E25" BorderBrush="#2F3642" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Scan-Protokoll" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Live-Events waehrend des Scans" Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Button Content="Kopieren" Style="{StaticResource ToolButton}" Margin="0,0,6,0" Click="OnCopyLogClicked"/>
                                                    <Button Content="Leeren" Style="{StaticResource ToolDangerButton}" Click="OnClearLogClicked"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding CompactLogText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource CodeBackgroundBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 Padding="14"
                                                 FontFamily="Consolas"
                                                 FontSize="10.5"
                                                 Height="220"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Naechster Schritt" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Nach dem Lauf wechselst du in den Bereich 'Treffer'." Margin="0,3,0,0" FontSize="10.2" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <CheckBox Content="Treffer direkt herunterladen" Style="{StaticResource InputCheckBox}" IsChecked="{Binding AutoDownloadAfterScan}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Treffer ansehen" Style="{StaticResource ToolPrimaryButton}" Margin="0,0,10,0" Click="OnResultsNavClicked"/>
                                    <Button Content="Konten" Style="{StaticResource ToolButton}" Click="OnAccountSettingsClicked"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Schnellzugriff" FontSize="11" FontWeight="SemiBold" Foreground="#BED1F4"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="Treffer" Style="{StaticResource ToolPrimaryButton}" Margin="0,0,8,0" Click="OnResultsNavClicked"/>
                                            <Button Content="Konten" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="OnAccountSettingsClicked"/>
                                            <Button Content="Verbindungen" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="OnTestConnectionsClicked"/>
                                            <Button Content="Update" Style="{StaticResource ToolButton}" Click="OnUpdateClicked"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Dashboard-Suche" FontSize="11" FontWeight="SemiBold" Foreground="#BED1F4"/>
                                        <TextBox Margin="0,6,0,0" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding DashboardSearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnDashboardSearchKeyDown" ToolTip="Absender, Betreff oder Dateiname suchen"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="Suchen" Style="{StaticResource ToolPrimaryButton}" VerticalAlignment="Center" Click="OnDashboardSearchClicked"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="0.78*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Letzte Treffer" FontSize="11" FontWeight="SemiBold" Foreground="#BED1F4"/>
                                            <Border Grid.Column="1" Style="{StaticResource ChipBorder}" Background="#10231B" BorderBrush="#2D6E55" Margin="12,0,0,0">
                                                <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="#8BE0B7"/>
                                            </Border>
                                        </Grid>
                                        <ListBox Grid.Row="2"
                                                 ItemsSource="{Binding DashboardRecentCandidates}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,0,1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="RowBorder" Background="#161D2A" BorderBrush="#2F3A50" BorderThickness="0,0,0,1" Padding="10,7">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="RowBorder" Property="Background" Value="#1B2433"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.ColumnSpan="2" Style="{StaticResource SecondaryButton}" Opacity="0" Click="OnDashboardRecentCandidateClicked"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Subject}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Sender}" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{Binding PriorityBadgeBackground}" BorderBrush="#31405A" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding PriorityBadgeLabel}" Foreground="{Binding PriorityBadgeForeground}" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Letzte Aktivität" FontSize="11" FontWeight="SemiBold" Foreground="#BED1F4"/>
                                        <TextBox Grid.Row="2"
                                                 Text="{Binding DashboardRecentLogText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="{StaticResource CodeBackgroundBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 Padding="10"
                                                 FontFamily="Consolas"
                                                 FontSize="10"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ResultsWorkspace" Visibility="{Binding ResultsPageVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0F1725" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,8" Visibility="{Binding ResultsScanStatusVisibility}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Scan läuft" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ScanProgressSummary}" Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ScanProgressPercentage, StringFormat={}{0:F0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ScanProgressBrush}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#0F1725" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,8" Visibility="{Binding ResultsHeaderVisibility}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="TREFFER" FontSize="10" FontWeight="SemiBold" Foreground="#9DB6E6"/>
                                    <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>

                                    <WrapPanel Margin="0,6,0,0">
                                        <Border Style="{StaticResource ChipBorder}" Background="#0F1725" BorderBrush="#334155">
                                            <TextBlock Text="{Binding PdfCandidateSummary}" FontSize="11" Foreground="#D9E6FF"/>
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}" Background="#0F1725" BorderBrush="#334155">
                                            <TextBlock Text="{Binding InvoiceMatchSummary}" FontSize="11" Foreground="#D9E6FF"/>
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}" Background="#0F1725" BorderBrush="#334155">
                                            <TextBlock Text="{Binding LookbackScopeSummary}" FontSize="11" Foreground="#D9E6FF"/>
                                        </Border>
                                    </WrapPanel>
                                    <Border Background="#10231B" BorderBrush="#2D6E55" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="0,6,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="AKTIV" FontSize="10" FontWeight="SemiBold" Foreground="#8BE0B7" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding CurrentResultsFilterLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#DDF9E8"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="1" Margin="12,0,0,0" Background="#101824" BorderBrush="#273548" BorderThickness="1" CornerRadius="12" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Kontext" FontSize="11" FontWeight="SemiBold" Foreground="#BED1F4"/>
                                        <TextBlock Text="Scanner und Zusatzinfos bleiben hier erreichbar, ohne die Tabelle zu dominieren." Margin="0,6,0,0" FontSize="10.2" Foreground="#D6DEEF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                            <Grid Grid.Row="1" Margin="0,0,0,0" Style="{StaticResource RevealGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="{Binding ResultsRightColumnWidth}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#111827" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,8" Visibility="{Binding ResultsPreviewSummaryVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="AKTUELLE VORSCHAU" FontSize="10" FontWeight="SemiBold" Foreground="#A9C2F3"/>
                                                <TextBlock Text="{Binding PreviewSubject}" Margin="0,4,0,0" FontSize="14.5" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                <WrapPanel Margin="0,6,0,0" Visibility="{Binding PreviewMetaVisibility}">
                                                    <Border Style="{StaticResource ChipBorder}" Background="#0F1725" BorderBrush="#334155"><TextBlock Text="{Binding PreviewSender}" FontSize="11" Foreground="#D9E6FF"/></Border>
                                                    <Border Style="{StaticResource ChipBorder}" Background="#0F1725" BorderBrush="#334155"><TextBlock Text="{Binding PreviewAccountName}" FontSize="11" Foreground="#D9E6FF"/></Border>
                                                    <Border Style="{StaticResource ChipBorder}" Background="#0F1725" BorderBrush="#334155"><TextBlock Text="{Binding PreviewReceivedAtDisplay}" FontSize="11" Foreground="#D9E6FF"/></Border>
                                                </WrapPanel>
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <Button Content="Datei oeffnen" Style="{StaticResource ToolPrimaryButton}" Margin="0,0,8,0" Click="OnOpenPreviewAttachmentClicked" IsEnabled="{Binding CanOpenPreviewAttachment}"/>
                                                <Button Content="Ordner zeigen" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="OnRevealPreviewAttachmentClicked" IsEnabled="{Binding CanOpenPreviewAttachment}"/>
                                                <Button Content="{Binding DownloadActionLabel}" Style="{StaticResource ToolButton}" Click="OnDownloadSelectionClicked" IsEnabled="{Binding CanDownloadPreviewAttachment}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Background="#171E2B" BorderBrush="#2D3850" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                                <Button x:Name="InvoiceResultsButton" Content="Rechnungen" Style="{StaticResource ToolbarActionPrimaryButton}" Margin="0,0,8,8" Click="OnShowInvoicesClicked"/>
                                                <Button x:Name="DownloadedResultsButton" Content="Downloads" Style="{StaticResource ToolbarFilterButton}" Margin="0,0,8,8" Click="OnShowDownloadedClicked"/>
                                                <Button x:Name="AllResultsButton" Content="Alle" Style="{StaticResource ToolbarFilterButton}" Margin="0,0,12,8" Click="OnShowAllResultsClicked"/>
                                                <Button x:Name="ViewButton" Style="{StaticResource ToolbarActionButton}" Margin="0,0,8,8" Click="OnViewClicked" IsEnabled="{Binding CanPreviewSelection}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Vorschau" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="OpenFileButton" Style="{StaticResource ToolbarActionButton}" Margin="0,0,8,8" Click="OnOpenSelectedFileClicked" IsEnabled="{Binding CanOpenSelectedFile}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Datei oeffnen" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="RevealFileButton" Style="{StaticResource ToolbarActionButton}" Margin="0,0,8,8" Click="OnRevealSelectedFileClicked" IsEnabled="{Binding CanOpenSelectedFile}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Ordner zeigen" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="DownloadButton" Style="{StaticResource ToolbarActionPrimaryButton}" Margin="0,0,8,8" Click="OnDownloadSelectionClicked" IsEnabled="{Binding CanDownloadSelection}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DownloadActionLabel}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="DeleteButton" Style="{StaticResource ToolbarActionDangerButton}" Margin="0,0,0,8" Click="OnDeleteClicked" IsEnabled="{Binding CanDeleteSelection}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Loeschen" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock x:Name="SelectionInfoText" Text="{Binding SelectionInfo}" Margin="14,4,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            </WrapPanel>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.65*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="1.0*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Suche" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Suche nach Konto, Betreff, Absender oder Dateiname"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Konto" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                                    <TextBox Style="{StaticResource SearchTextBoxStyle}" Text="{Binding AccountFilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Konto oder Mailadresse"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Absender" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                                    <TextBox Style="{StaticResource SearchTextBoxStyle}" Text="{Binding SenderFilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Absender filtern"/>
                                                </StackPanel>

                                                <WrapPanel Grid.Column="6" VerticalAlignment="Bottom">
                                                    <CheckBox Content="Datei fehlt" Style="{StaticResource InputCheckBox}" IsChecked="{Binding OnlyMissingFiles}" Margin="0,0,12,0"/>
                                                    <CheckBox Content="Mit Anhang" Style="{StaticResource InputCheckBox}" IsChecked="{Binding OnlyWithAttachments}" Margin="0,0,12,0"/>
                                                    <CheckBox Content="Nur PDF / DOC" Style="{StaticResource InputCheckBox}" IsChecked="{Binding OnlyDocPdf}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <ListBox Grid.Row="2"
                                             x:Name="CandidatesGrid"
                                             ItemsSource="{Binding Candidates}"
                                             SelectionMode="Extended"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionChanged="OnCandidatesSelectionChanged"
                                             MouseDoubleClick="OnCandidatesMouseDoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,1"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="RowBorder" Background="#1E232D" BorderBrush="#2C3544" BorderThickness="0,0,0,1" Padding="14,11">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="RowBorder" Property="Background" Value="#242A35"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="RowBorder" Property="Background" Value="#243246"/>
                                                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="#4E86FF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Subject}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Row="0" Grid.Column="1" Background="{Binding PriorityBadgeBackground}" BorderBrush="#31405A" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding PriorityBadgeLabel}" Foreground="{Binding PriorityBadgeForeground}" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0">
                                                        <TextBlock Text="{Binding AccountName}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding Sender}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" ToolTip="{Binding Sender}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ReceivedAtDisplay}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding AttachmentName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" ToolTip="{Binding AttachmentName}" TextTrimming="CharacterEllipsis"/>
                                                        <Border Background="#141B28" BorderBrush="#283448" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding MatchReasonCompact}" ToolTip="{Binding MatchReason}" Foreground="#BFD0EA" FontSize="10"/>
                                                        </Border>
                                                        <Border Background="{Binding StatusBadgeBackground}" BorderBrush="#31405A" BorderThickness="1" CornerRadius="6" Padding="7,2">
                                                            <TextBlock Text="{Binding StatusBadgeLabel}" Foreground="{Binding StatusBadgeForeground}" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Row="0"
                                          Grid.Column="1"
                                          Width="8"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Columns"
                                          ShowsPreview="True"
                                          Visibility="{Binding ResultsSupportPanelVisibility}"/>

                            <Grid Grid.Row="0" Grid.Column="2" Visibility="{Binding ResultsSupportPanelVisibility}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#20242D" BorderBrush="#313846" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Trefferdetails" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PreviewMatchReason}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ChipBorder}" Background="#151A22" BorderBrush="#303744" Margin="12,0,0,0">
                                            <TextBlock Text="Doppelklick = Vorschau + Datei oeffnen" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="#20242D" BorderBrush="#313846" BorderThickness="1" CornerRadius="12" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#1B2028" BorderBrush="#2F3642" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="Mail-Inhalt" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Wenn noch keine lokale Datei vorliegt, siehst du hier trotzdem schon den Kontext zum Treffer." Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBox Grid.Row="1" Text="{Binding PreviewContentText}" IsReadOnly="True" BorderThickness="0" Background="{StaticResource CodeBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="14" FontFamily="Consolas" FontSize="10.8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="AccountsWorkspace" Visibility="{Binding AccountsPageVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#273142" BorderBrush="#334152" BorderThickness="1" CornerRadius="16" Padding="14,11" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ACCOUNT WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#9DB6E6"/>
                                    <TextBlock Text="Konten und Speicherorte" Margin="0,3,0,0" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Konten verwalten, testen und direkt im Hauptfenster speichern." Margin="0,3,0,0" FontSize="11" Foreground="#D4DCEE" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Border Style="{StaticResource ChipBorder}" Background="#1D2430" BorderBrush="#4C5D80">
                                            <TextBlock Text="{Binding AccountCountSummary}" FontSize="11" Foreground="#D9E6FF"/>
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}" Background="#1D2430" BorderBrush="#4C5D80">
                                            <TextBlock Text="{Binding SettingsStorageSummary}" FontSize="11" Foreground="#D9E6FF"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SettingsProviderSummary}" Margin="0,4,0,0" FontSize="10.2" Foreground="#D6DEEF" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="1" Margin="16,0,0,0" Background="#1B2230" BorderBrush="#34518A" BorderThickness="1" CornerRadius="14" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Hinweis" FontSize="11" FontWeight="SemiBold" Foreground="#BED1F4"/>
                                        <TextBlock Text="Gmail nutzt meist App-Passwort, sobald 2FA aktiv ist." Margin="0,6,0,0" FontSize="10.2" Foreground="#D6DEEF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#161D29" BorderBrush="#334155" BorderThickness="1" CornerRadius="16" Padding="12" VerticalAlignment="Top">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Konto-Explorer" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0"/>
                                    <TextBlock Text="Bestehende Eintraege waehlen oder neue Konten vorbereiten" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Row="1" Background="#0F1725" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Aktive Konten" FontSize="10.5" FontWeight="SemiBold" Foreground="#BED1F4"/>
                                            <TextBlock Text="{Binding AccountCountSummary}" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="+" Style="{StaticResource ToolbarIconButton}" ToolTip="Neues Konto" Click="OnEmbeddedAddAccountClicked"/>
                                            <Button Content="-" Style="{StaticResource ToolbarIconButton}" Margin="8,0,0,0" ToolTip="Konto loeschen" Click="OnEmbeddedRemoveAccountClicked"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <ListBox x:Name="EmbeddedAccountsListBox"
                                 Grid.Row="2"
                                          ItemsSource="{Binding EditorAccounts}"
                                          SelectedItem="{Binding SelectedEditorAccount}"
                                          SelectionChanged="OnEmbeddedAccountSelectionChanged"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" Background="#20263A" BorderBrush="#4B69A4" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                                                    <TextBlock Text="@" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C5D8FF" FontWeight="SemiBold"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding EmailAddress}" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ImapHost}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder" Background="#1A2230" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="SelectionIndicator" Width="3" Margin="0,2,10,2" CornerRadius="2" Background="{StaticResource AccentBrush}" Opacity="0"/>
                                                                <ContentPresenter Grid.Column="1"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4A607A"/>
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#213047"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E3A56"/>
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <TextBlock Grid.Row="3" Text="Ausgewaehltes Konto bearbeiten" Margin="0,6,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Grid.RowSpan="3" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AKTIVES KONTO" FontSize="10" FontWeight="SemiBold" Foreground="#9DB6E6"/>
                                        <TextBlock Text="{Binding SelectedEditorAccount.DisplayName}" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedEditorAccountSummary}" Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Debug" Style="{StaticResource ToolButton}" Width="92" HorizontalAlignment="Right" Click="OnOpenDebugClicked"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#161D29" BorderBrush="#334155" BorderThickness="1" CornerRadius="16" Padding="16,14" VerticalAlignment="Top">
                                <TabControl>
                                    <TabItem Header="Konto">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Konto" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Anzeigename" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputTextBox}" Foreground="White" Text="{Binding SelectedEditorAccount.DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="E-Mail" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource InputTextBox}" Foreground="White" Text="{Binding SelectedEditorAccount.EmailAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" Text="Benutzername" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource InputTextBox}" Foreground="White" Text="{Binding SelectedEditorAccount.UserName, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" Text="Passwort" Style="{StaticResource FieldLabel}"/>
                                                <PasswordBox x:Name="EmbeddedPasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource InputPasswordBox}" PasswordChanged="OnEmbeddedPasswordChanged"/>
                                            </Grid>

                                            <Border Grid.Column="2" Background="#0F1725" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock Text="Schnellinfo" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Name, Mailadresse, Benutzername und Passwort gelten fuer das aktuell links gewaehlte Konto." Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="IMAP">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="IMAP-Einstellungen" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Server" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputTextBox}" Foreground="White" Text="{Binding SelectedEditorAccount.ImapHost, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" Text="Port" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Width="140" HorizontalAlignment="Left" Style="{StaticResource InputTextBox}" Foreground="White" Text="{Binding SelectedEditorAccount.ImapPort}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,12,0,0" Text="Ordner" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource InputTextBox}" Foreground="White" Text="{Binding SelectedEditorAccount.FolderName, UpdateSourceTrigger=PropertyChanged}"/>
                                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                                    <CheckBox Content="SSL verwenden" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.UseSsl}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border Grid.Column="2" Background="#0F1725" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock Text="Best Practice" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Fuer produktive Postfaecher empfehlen sich IMAP ueber 993, SSL und ein dedizierter Zielordner wie INBOX." Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="Filter">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Globale Einstellungen" Style="{StaticResource SectionTitle}"/>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Lookback" Style="{StaticResource FieldLabel}" Margin="0,9,0,0"/>
                                                    <TextBox Grid.Column="1" Width="104" Style="{StaticResource InputTextBox}" Text="{Binding EditorInitialLookbackDays}"/>
                                                    <TextBlock Grid.Column="2" Text="Tage" Margin="12,9,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>
                                                <TextBlock Text="Ausgeschlossene Ordner / Muster" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding EditorExcludedFolderPatternsText, UpdateSourceTrigger=PropertyChanged}" Height="156" Style="{StaticResource InputTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                                                <TextBlock Text="Jede Zeile entspricht einem Muster oder Ordner, der beim Scan uebersprungen wird." Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Dateitypen" Style="{StaticResource SectionTitle}"/>
                                                <WrapPanel>
                                                    <CheckBox Content="PDF" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchPdf}" Margin="0,0,14,10"/>
                                                    <CheckBox Content="DOC" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchDoc}" Margin="0,0,14,10"/>
                                                    <CheckBox Content="DOCX" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchDocx}" Margin="0,0,14,10"/>
                                                    <CheckBox Content="XLS" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchXls}" Margin="0,0,14,10"/>
                                                    <CheckBox Content="XLSX" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchXlsx}" Margin="0,0,14,10"/>
                                                    <CheckBox Content="PPT" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchPpt}" Margin="0,0,14,10"/>
                                                    <CheckBox Content="PPTX" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchPptx}" Margin="0,0,14,10"/>
                                                    <CheckBox Content="Bilder" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchImages}" Margin="0,0,14,10"/>
                                                    <CheckBox Content="TXT" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchTxt}" Margin="0,0,14,10"/>
                                                    <CheckBox Content="Sonstige" Style="{StaticResource InputCheckBox}" IsChecked="{Binding SelectedEditorAccount.SearchOther}" Margin="0,0,14,10"/>
                                                </WrapPanel>
                                                <TextBlock Text="Nur aktivierte Dateitypen werden beim Scan als Kandidaten uebernommen." Margin="0,10,0,18" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="Ignorierte Dateinamen" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock Text="Muster pro Zeile, z.B. logo, impressum, agb, footer" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SelectedEditorAccount.IgnoredAttachmentNamePatternsText, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="120"
                                                         Style="{StaticResource InputTextBox}"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextWrapping="Wrap"/>
                                                <TextBlock Text="Wenn ein Dateiname eines dieser Muster enthaelt, wird der Anhang beim Import uebersprungen." Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="Speicherorte">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Speicherorte" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock Text="Datenbank" Style="{StaticResource FieldLabel}"/>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}" Text="{Binding EditorDatabasePath}" IsReadOnly="True"/>
                                                    <Button Grid.Column="1" Content="..." Style="{StaticResource ToolbarIconButton}" Margin="8,0,0,0" Click="OnEmbeddedBrowseDatabaseClicked"/>
                                                </Grid>
                                                <TextBlock Text="Dokumentenordner" Style="{StaticResource FieldLabel}"/>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}" Text="{Binding EditorDocumentRootPath}" IsReadOnly="True"/>
                                                    <Button Grid.Column="1" Content="..." Style="{StaticResource ToolbarIconButton}" Margin="8,0,0,0" Click="OnEmbeddedBrowseDocumentClicked"/>
                                                </Grid>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#0F1725" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock Text="Tipp" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Verwende kurze, stabile Speicherpfade, damit Downloads und Vorschauen zuverlaessig funktionieren." Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Grid>

                        <Border Grid.Row="4" Grid.ColumnSpan="3" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="12,9" Margin="0,10,0,0" VerticalAlignment="Bottom">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Aenderungen zuerst testen, danach speichern." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Lokale Konfiguration wird direkt aktualisiert." Margin="0,3,0,0" FontSize="9.8" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Scanner" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="OnScannerNavClicked"/>
                                    <Button Content="Dieses Konto testen" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="OnEmbeddedTestSelectedClicked" IsEnabled="{Binding CanSaveAccountSettings}"/>
                                    <Button Content="Alle testen" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="OnEmbeddedTestAllClicked" IsEnabled="{Binding CanSaveAccountSettings}"/>
                                    <Button Content="Speichern" Style="{StaticResource ToolPrimaryButton}" Click="OnEmbeddedSaveClicked" IsEnabled="{Binding CanSaveAccountSettings}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>

                    <Grid x:Name="UpdateWorkspace" Visibility="{Binding UpdatePageVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#273142" BorderBrush="#334152" BorderThickness="1" CornerRadius="16" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="UPDATE WORKFLOW" FontSize="10" FontWeight="SemiBold" Foreground="#A9C2F3"/>
                                    <TextBlock Text="Release und Installer" Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding UpdatePanelVersionSummary}" Margin="0,8,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="#D9E6FF"/>
                                    <TextBlock Text="{Binding UpdatePanelInstallerSummary}" Margin="0,6,0,0" FontSize="11.5" Foreground="#D6DEEF" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Margin="16,0,0,0" Background="#1B2230" BorderBrush="#34518A" BorderThickness="1" CornerRadius="14" Padding="11">
                                    <StackPanel>
                                        <TextBlock Text="Release" FontSize="11" FontWeight="SemiBold" Foreground="#BED1F4"/>
                                        <TextBlock Text="{Binding UpdatePanelReleaseTitle}" Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding UpdatePanelStatusMessage}" Margin="0,6,0,0" FontSize="10.5" Foreground="#D6DEEF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Ablauf" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,10"><TextBlock Text="1. Release-Seite pruefen" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/></Border>
                                        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,10"><TextBlock Text="2. Installer herunterladen" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/></Border>
                                        <Border Style="{StaticResource InsetCard}"><TextBlock Text="3. Setup starten und Dateien ersetzen" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/></Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SurfaceCard}">
                                    <StackPanel>
                                        <TextBlock Text="Hinweis" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Der Update-Check laeuft beim Start automatisch gegen GitHub Releases. Installer-Downloads koennen direkt hier ausgelost werden." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#1A1E25" BorderBrush="#2F3642" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="16,12">
                                        <StackPanel>
                                            <TextBlock Text="Release-Notizen" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding UpdatePanelReleaseTitle}" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Style="{StaticResource InsetCard}" CornerRadius="0,0,12,12" Padding="0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding UpdatePanelReleaseNotes}" Padding="18" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="20"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="16,12" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding UpdatePanelStatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Width="124" Content="Release-Seite" Style="{StaticResource ToolButton}" Margin="0,0,10,0" Click="OnOpenReleasePageClicked"/>
                                    <Button Width="132" Content="Update holen" Style="{StaticResource ToolPrimaryButton}" Margin="0,0,10,0" Click="OnInstallUpdateClicked" IsEnabled="{Binding CanInstallUpdate}"/>
                                    <Button Width="86" Content="Scanner" Style="{StaticResource ToolButton}" Click="OnScannerNavClicked"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" Padding="16,12" Margin="0,14,0,0" Visibility="{Binding UpdateDownloadProgressVisibility}">
                            <StackPanel>
                                <TextBlock Text="Download-Fortschritt" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding UpdateDownloadProgressSummary}" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <ProgressBar Margin="0,10,0,0" Height="10" Minimum="0" Maximum="100" Value="{Binding UpdateDownloadProgressValue}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="DebugWorkspace" Visibility="{Binding DebugPageVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#273142" BorderBrush="#334152" BorderThickness="1" CornerRadius="16" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DIAGNOSTIC WORKSPACE" Style="{StaticResource SmallCaption}" Foreground="#A9C2F3"/>
                                    <TextBlock Text="Debug Output" Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Konfiguration, geladene Einstellungen und Fehler ohne weiteres Fenster pruefen." Margin="0,5,0,0" FontSize="11.5" Foreground="#D6DEEF" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Margin="16,0,0,0" Background="#1B2230" BorderBrush="#34518A" BorderThickness="1" CornerRadius="14" Padding="11">
                                    <StackPanel>
                                        <TextBlock Text="Live-Status" FontSize="11" FontWeight="SemiBold" Foreground="#BED1F4"/>
                                        <TextBlock Text="{Binding DebugLog.StatusText}" Margin="0,8,0,0" FontSize="10.5" Foreground="#D6DEEF" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DebugLog.TimestampText}" Margin="0,6,0,0" FontSize="10.5" Foreground="#D6DEEF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Werkzeuge" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock Text="Debug zeigt technische Rohdaten: Konfigurationsdatei = gespeicherte Werte, Settings = geladene App-Einstellungen, Fehler = Ausnahmen." Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Kopieren" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="OnCopyDebugClicked"/>
                                    <Button Content="Leeren" Style="{StaticResource ToolDangerButton}" Click="OnClearDebugClicked"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.95*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.05*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource InsetCard}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#1A1E25" BorderBrush="#2F3642" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="14,10">
                                                <TextBlock Text="Konfigurationsdatei" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBox Grid.Row="1" Text="{Binding DebugLog.RegistryText, Mode=OneWay}" IsReadOnly="True" Background="{StaticResource CodeBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="14" FontFamily="Consolas" FontSize="10.5" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Style="{StaticResource InsetCard}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#1A1E25" BorderBrush="#2F3642" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="14,10">
                                                <TextBlock Text="Geladene Settings" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBox Grid.Row="1" Text="{Binding DebugLog.SettingsText, Mode=OneWay}" IsReadOnly="True" Background="{StaticResource CodeBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="14" FontFamily="Consolas" FontSize="10.5" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.15*"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="0.85*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource InsetCard}" Padding="0" BorderBrush="#6C3E46">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#231419" BorderBrush="#6C3E46" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="14,10">
                                                <TextBlock Text="Fehler" FontSize="12" FontWeight="SemiBold" Foreground="#FFD7DA"/>
                                            </Border>
                                            <TextBox Grid.Row="1" Text="{Binding DebugLog.ErrorText, Mode=OneWay}" IsReadOnly="True" Background="#190F12" Foreground="#FFD7DA" BorderThickness="0" Padding="14" FontFamily="Consolas" FontSize="10.5" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Style="{StaticResource InsetCard}" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#1A1E25" BorderBrush="#2F3642" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="14,10">
                                                <TextBlock Text="Allgemein" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBox Grid.Row="1" Text="{Binding DebugLog.GeneralText, Mode=OneWay}" IsReadOnly="True" Background="{StaticResource CodeBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="14" FontFamily="Consolas" FontSize="10.5" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" Padding="16,12" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DebugLog.StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DebugLog.TimestampText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Visibility="{Binding ScanNotificationVisibility}"
                        Background="#1E2430"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,18,18"
                        Panel.ZIndex="20">
                    <StackPanel>
                        <TextBlock Text="Scan abgeschlossen" FontSize="11" FontWeight="SemiBold" Foreground="#BFD3FF"/>
                        <TextBlock Text="{Binding ScanNotificationText}" Margin="0,4,0,0" FontSize="12" Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
